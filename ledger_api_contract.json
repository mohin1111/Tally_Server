  "_schema_info": {
    "description": "Tally Ledger Creation API - Request Body Contract",
    "endpoint": "POST /create-ledger",
    "content_type": "application/json",
    "rules": {
      "required_fields": "Only company_name + each ledger's name & parent are required. Everything else is optional.",
      "null_or_omit": "Set a field to null or omit it entirely to skip it in the generated XML.",
      "empty_string": "An empty string '' will produce an empty XML tag. Use null to skip the tag entirely.",
      "booleans": "true/false in JSON becomes Yes/No in Tally XML. null or omitted defaults to No.",
      "dates": "YYYYMMDD format as string (e.g. '20240401').",
      "amounts": "String to preserve Tally formatting (e.g. '50000', '-25000 Dr', '10000 Cr').",
      "arrays": "Accept one or more entries. Use null or omit to produce an empty Tally list tag.",
      "batch": "The ledgers array supports multiple ledgers in a single request."
    }
  },
